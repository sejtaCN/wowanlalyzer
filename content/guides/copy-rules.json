  "principles": [
    "结论前置：先给该做什么，再给为什么，最后给数据。",
    "删掉分析过程与设问，只留结论。",
    "书面化：正文不写「我们 / 接下来 / 我觉得」。",
    "并列用列表，机器级细节折叠。",
    "有出处的名字用中文，没出处的保留标识符并用「」框住，绝不自造官方译名。"
  ],
  "bannedWords": {
    "error": [
      "按 B[0-9]",
      "还没写",
      "下一批",
      "门禁",
      "批次",
      "content/",
      "scripts/",
      ".mjs",
      ".simc",
      "validate:content",
      "sims-run",
      "leverage.mjs",
      "**",
      "APL 原文："
    ],
    "warn": [
      "我觉得",
      "我们",
      "接下来",
      "首先",
      "其次",
      "综上所述",
      "总而言之",
      "众所周知",
      "值得注意的是",
      "由此可见",
      "换句话说",
      "也就是说",
      "其实",
      "说白了",
      "总的来说"
    ]
  },
  "latinPolicy": {
    "comment": "正文里的拉丁字符只有两类允许：① 公认术语 ② 用「」框住的机器标识符。其余一律中文化。机器条件的中文翻译用「APL 条件：」前缀，原始写法放折叠区。",
    "allowed": [
