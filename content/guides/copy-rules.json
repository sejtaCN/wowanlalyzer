  "contentTypes": {
    "chart": {
      "name": "图表与数据描述",
      "fields": [
        "claim",
        "chart.title",
        "②段导读",
        "casePanel.points"
      ],
      "rules": [
        "一句话说清这张图要回答的问题，标题写「读者看完要知道什么」，不写「这是什么图」。",
        "先给动作结论（做什么），再给数值（多少），最后给阈值（什么时候变）。",
        "数值保留原始精度，不做二次四舍五入。",
        "导读句必须指出看哪里：哪根柱、哪一列、哪一行。",
        "误差带要写明是误差，不要让读者把它当成收益。"
      ]
    },
    "skill": {
      "name": "技能介绍",
      "fields": [
        "skills.json 的 zh",
        "L0-02 技能清单",
        "优先级卡的条件行"
      ],
      "rules": [
        "技能名只写中文；英文键放悬停提示，不占正文行。",
        "每个技能四件事说清：定位（干什么）、机制要点（什么条件触发）、适用场景（什么时候用）、收益（值多少）。",
        "没有官方中文名的天赋 / buff / 变量，用「」框成标识符，不自造译名。",
        "同一技能的四种说法不重复堆叠，一条只讲一件事。"
      ]
    },
    "priority": {
      "name": "技能优先级",
      "fields": [
        "priorityDiff.reason",
        "priorityDiff.evidence",
        "priorityDiff.raw",
        "priority-table 的条件列"
      ],
      "rules": [
        "分级只有两档：这一波要加 / 这一波要降。序号用 APL 表里的真实执行位置。",
        "排序理由一条一句，句式：条件 → 结论。",
        "条件分支必须写清触发阈值（目标数、剩余血量%、冷却秒数）。",
        "人话条件与 APL 原文并列：正文写中文，APL 原文收进折叠区，信息一条不丢。",
        "不写「为什么不能反着来」这类反问，只写结论。"
      ]
    },
    "visual": {
      "name": "可视化部分",
      "fields": [
        "①段导读",
        "④段导读",
        "chart.kind",
        "map"
      ],
      "rules": [
        "先说这张图看什么，再说怎么读（柱高、位置、颜色各代表什么）。",
        "流程 / 路线按顺序编号，用箭头连接，不写成一段散文。",
        "界面指引写清「点哪里会看到什么」。",
        "没有坐标就不标坐标；没有分段就不假装有分段。"
      ]
    }
  },
  "sentencePatterns": {
    "结论句": "句号收尾；动词开头；不出现主语「我们」。",
    "数值句": "数字 + 单位紧连（30 秒 / 12.7M / 43.98%），数值前后不加解释性从句。",
    "并列句": "用「、」或「；」分隔并列项，不用逗号连成长串。",
    "条件句": "「如果 X，就 Y」或「X 时 Y」；阈值写成「≥ 5 只」这种紧贴形式。",
    "收尾句": "一句话给限制或边界（数据缺口、适用边界），不写免责套话。"
  },
  "lengthBudget": {
    "subtitle": {
      "max": 25,
      "unit": "字符"
    },
    "claim": {
      "max": 120,
      "unit": "字符"
    },
